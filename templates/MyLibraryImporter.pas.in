const
    BridgeExecutable = '@@EXECUTABLE@@';
    BridgeRoot = '@@ROOT@@';
    BridgeCache = '@@CACHE@@';
    MyLibraryRoot = '@@LIBROOT@@';

var MyLibraryFormV31 : TMyLibraryFormV31;
    BridgeJobId, BridgeReplyPath : String;
    BridgePollTicks : Integer;
    BridgeStartedAt : Double;

function ValidCode(Code : String) : Boolean;
var I : Integer;
begin
    Result := False;
    if (Length(Code) < 2) or (Length(Code) > 13) then Exit;
    if Code[1] <> 'C' then Exit;
    for I := 2 to Length(Code) do if (Code[I] < '0') or (Code[I] > '9') then Exit;
    Result := Code[2] <> '0';
end;

function VerifyMasterModels(Manager : IIntegratedLibraryManager; ReplyPath : String) : Boolean;
var Data : TStringList; I, Count : Integer; Name, Footprint : String;
begin
    Result := False;
    Data := TStringList.Create;
    try
        Data.LoadFromFile(ReplyPath);
        Count := StrToInt(Data.Values['binding_count']);
        if Count <> Manager.GetComponentCount(Data.Values['intlib']) then Exit;
        for I := 0 to Count - 1 do begin
            Name := Data.Values['binding_name' + IntToStr(I)];
            Footprint := Data.Values['binding_footprint' + IntToStr(I)];
            if Manager.ModelCount(Name, Data.Values['intlib'], 'PCBLIB') <> 1 then begin ShowMessage('Default footprint is missing: ' + Name); Exit; end;
            if Manager.ModelName(Name, Data.Values['intlib'], 'PCBLIB', 0) <> Footprint then begin ShowMessage('Default footprint differs: ' + Name); Exit; end;
        end;
        Result := True;
    finally
        Data.Free;
    end;
end;

function SaveNativeSource(Path, Kind, FormatName : String) : Boolean;
var Document : IServerDocument;
begin
    Result := True;
    if Path = '' then Exit;
    Document := Client.GetDocumentByPath(Path);
    if Document <> Nil then begin
        if Document.Modified then begin ShowMessage('Save your source library edits before importing: ' + Path); Result := False; Exit; end;
        Client.CloseDocument(Document);
        if Client.GetDocumentByPath(Path) <> Nil then begin ShowMessage('Close the source library before reloading: ' + Path); Result := False; Exit; end;
    end;
    Document := Client.OpenDocument(Kind, Path);
    if Document = Nil then begin Result := False; Exit; end;
    Client.ShowDocument(Document);
    Document.Modified := True;
    Result := Document.DoFileSave(FormatName);
end;

procedure TMyLibraryFormV31.FormShow(Sender : TObject);
var RequiredWidth, RequiredHeight, Edge, Gap : Integer;
begin
    Gap := CodeEdit.Left;
    if Gap < 16 then Gap := 16;
    RequiredWidth := CodeEdit.Left + CodeEdit.Width;
    Edge := CodeLabel.Left + CodeLabel.Width;
    if Edge > RequiredWidth then RequiredWidth := Edge;
    Edge := StatusLabel.Left + StatusLabel.Width;
    if Edge > RequiredWidth then RequiredWidth := Edge;
    Edge := StartButton.Left + StartButton.Width;
    if Edge > RequiredWidth then RequiredWidth := Edge;
    Edge := CancelButton.Left + CancelButton.Width;
    if Edge > RequiredWidth then RequiredWidth := Edge;
    Edge := CheckButton.Left + CheckButton.Width;
    if Edge > RequiredWidth then RequiredWidth := Edge;
    RequiredWidth := RequiredWidth + Gap;
    RequiredHeight := CancelButton.Top + CancelButton.Height + Gap;
    Edge := StartButton.Top + StartButton.Height + Gap;
    if Edge > RequiredHeight then RequiredHeight := Edge;
    Edge := StatusLabel.Top + StatusLabel.Height + Gap;
    if Edge > RequiredHeight then RequiredHeight := Edge;
    if ClientWidth < RequiredWidth then ClientWidth := RequiredWidth;
    if ClientHeight < RequiredHeight then ClientHeight := RequiredHeight;
end;

procedure TMyLibraryFormV31.StartButtonClick(Sender : TObject);
var Code : String;
    Request : TStringList;
    SourceDocument : IServerDocument;
begin
    SourceDocument := Client.GetDocumentByPath(MyLibraryRoot + '\MyParts.SchLib');
    if SourceDocument <> Nil then if SourceDocument.Modified then begin ShowMessage('Save MyParts.SchLib before importing.'); Exit; end;
    SourceDocument := Client.GetDocumentByPath(MyLibraryRoot + '\MyFootprints.PcbLib');
    if SourceDocument <> Nil then if SourceDocument.Modified then begin ShowMessage('Save MyFootprints.PcbLib before importing.'); Exit; end;
    Code := UpperCase(Trim(CodeEdit.Text));
    if not ValidCode(Code) then begin ShowMessage('Enter an LCSC code such as C8734.'); Exit; end;
    if not FileExists(BridgeExecutable) then begin ShowMessage('The launcher is missing. Run setup.cmd again.'); Exit; end;
    BridgeJobId := GetWorkspace.DM_GenerateUniqueID;
    BridgeReplyPath := BridgeRoot + '\response_' + BridgeJobId + '.ini';
    Request := TStringList.Create;
    try
        Request.Add('job_id=' + BridgeJobId);
        Request.Add('code=' + Code);
        Request.Add('mode=my_library');
        Request.SaveToFile(BridgeRoot + '\job_' + BridgeJobId + '.ini');
    finally
        Request.Free;
    end;
    BridgePollTicks := 0;
    BridgeStartedAt := Now;
    CodeEdit.Enabled := False;
    StartButton.Enabled := False;
    CheckButton.Enabled := True;
    ImportProgress.Position := 5;
    StatusLabel.Caption := 'Downloading and checking symbol, footprint and STEP...';
    try
        PollTimer.Enabled := True;
        RunApplication(BridgeExecutable);
    except
        CodeEdit.Enabled := True;
        StartButton.Enabled := True;
        StatusLabel.Caption := 'Cannot start the launcher. Check ad-launcher.log.';
    end;
end;

procedure PollImportResult;
var Reply, ProgressData : TStringList;
    ErrorText : String;
    Percent : Integer;
begin
    BridgePollTicks := BridgePollTicks + 1;
    MyLibraryFormV31.StatusLabel.Caption := 'Downloading/checking, elapsed ' + IntToStr(Trunc((Now - BridgeStartedAt) * 86400)) + ' s. If this counter stops, click Check result.';
    if FileExists(BridgeRoot + '\progress_' + BridgeJobId + '.ini') then begin
        ProgressData := TStringList.Create;
        try
            ProgressData.LoadFromFile(BridgeRoot + '\progress_' + BridgeJobId + '.ini');
            if ProgressData.Values['job_id'] = BridgeJobId then begin
                Percent := StrToInt(ProgressData.Values['percent']);
                if (Percent >= 0) and (Percent <= 85) then MyLibraryFormV31.ImportProgress.Position := Percent;
                MyLibraryFormV31.StatusLabel.Caption := ProgressData.Values['stage'] + ' (' + IntToStr(Percent) + '%), elapsed ' + IntToStr(Trunc((Now - BridgeStartedAt) * 86400)) + ' s.';
            end;
        finally
            ProgressData.Free;
        end;
    end;
    if not FileExists(BridgeReplyPath) then begin
        if (Now - BridgeStartedAt) * 86400 > 300 then begin
            MyLibraryFormV31.PollTimer.Enabled := False;
            MyLibraryFormV31.CodeEdit.Enabled := True;
            MyLibraryFormV31.StartButton.Enabled := True;
            MyLibraryFormV31.StatusLabel.Caption := 'Timed out. Check result can recover a completed job; see ad-launcher.log.';
        end;
        Exit;
    end;
    Reply := TStringList.Create;
    try
        Reply.LoadFromFile(BridgeReplyPath);
        if Reply.Values['job_id'] <> BridgeJobId then Exit;
        MyLibraryFormV31.PollTimer.Enabled := False;
        if Reply.Values['status'] = 'ok' then MyLibraryFormV31.ModalResult := mrOk
        else begin
            ErrorText := Reply.Values['error'];
            MyLibraryFormV31.CodeEdit.Enabled := True;
            MyLibraryFormV31.StartButton.Enabled := True;
            MyLibraryFormV31.StatusLabel.Caption := 'Import stopped: ' + ErrorText;
            ShowMessage(ErrorText);
        end;
    finally
        Reply.Free;
    end;
end;

procedure TMyLibraryFormV31.PollTimerTimer(Sender : TObject);
begin
    PollImportResult;
end;

procedure TMyLibraryFormV31.CheckButtonClick(Sender : TObject);
begin
    if BridgeJobId = '' then Exit;
    PollImportResult;
end;

procedure TMyLibraryFormV31.CancelButtonClick(Sender : TObject);
begin
    PollTimer.Enabled := False;
    ModalResult := mrCancel;
end;

procedure ImportComponent(PlaceNow : Boolean);
var ProjectPath, LibraryPath, SymbolName, FootprintName, SheetPath, InstalledPath : String;
    Reply : TStringList;
    Project, OriginalProject : IProject;
    Manager : IIntegratedLibraryManager;
    Sheet : ISch_Document;
    X, Y, I, DialogResult, ExpectedCount, DocumentCount, RemoveCount : Integer;
begin
    Manager := IntegratedLibraryManager;
    if Manager = Nil then begin ShowMessage('Integrated library manager is unavailable.'); Exit; end;
    SheetPath := '';
    OriginalProject := GetWorkspace.DM_FocusedProject;
    if PlaceNow then begin
        if SchServer = Nil then begin ShowMessage('Open a schematic sheet first.'); Exit; end;
        Sheet := SchServer.GetCurrentSchDocument;
        if Sheet = Nil then begin ShowMessage('Open a schematic sheet first.'); Exit; end;
        SheetPath := Sheet.DocumentName;
        if UpperCase(ExtractFileExt(SheetPath)) <> '.SCHDOC' then begin ShowMessage('Open a saved .SchDoc sheet first.'); Exit; end;
    end;
    MyLibraryFormV31.PollTimer.Enabled := False;
    MyLibraryFormV31.CodeEdit.Enabled := True;
    MyLibraryFormV31.StartButton.Enabled := True;
    MyLibraryFormV31.CheckButton.Enabled := False;
    MyLibraryFormV31.ImportProgress.Position := 0;
    MyLibraryFormV31.Enabled := True;
    MyLibraryFormV31.StatusLabel.Caption := 'Enter an LCSC code and click Import.';
    BridgeJobId := '';
    MyLibraryFormV31.Visible := False;
    DialogResult := MyLibraryFormV31.ShowModal;
    MyLibraryFormV31.PollTimer.Enabled := False;
    if DialogResult <> mrOk then begin
        if BridgeJobId <> '' then begin
            Reply := TStringList.Create;
            try
                Reply.Add('cancelled=True');
                Reply.SaveToFile(BridgeRoot + '\cancel_' + BridgeJobId + '.ini');
            finally
                Reply.Free;
            end;
        end;
        Exit;
    end;
    Reply := TStringList.Create;
    try
        Reply.LoadFromFile(BridgeReplyPath);
        if (Reply.Values['status'] <> 'ok') or (Reply.Values['job_id'] <> BridgeJobId) then begin ShowMessage('Import response does not match this request.'); Exit; end;
        ProjectPath := Reply.Values['project'];
        LibraryPath := Reply.Values['intlib'];
        SymbolName := Reply.Values['symbol'];
        FootprintName := Reply.Values['footprint'];
        if not SaveNativeSource(Reply.Values['source_add_sch'], 'SCHLIB', 'Advanced Schematic binary library') then begin ShowMessage('Native schematic library save failed.'); Exit; end;
        if not SaveNativeSource(Reply.Values['source_add_pcb'], 'PCBLIB', 'PCB Library File') then begin ShowMessage('Native footprint library save failed.'); Exit; end;
        ExpectedCount := StrToInt(Reply.Values['expected_components']);
        Project := GetWorkspace.DM_OpenProject(ProjectPath, False);
        if Project = Nil then begin ShowMessage('Cannot open MyLibrary project.'); Exit; end;
        RemoveCount := StrToInt(Reply.Values['remove_document_count']);
        for I := 0 to RemoveCount - 1 do begin
            InstalledPath := Reply.Values['remove_document' + IntToStr(I)];
            if Project.DM_IndexOfSourceDocument(InstalledPath) >= 0 then Project.DM_RemoveSourceDocument(InstalledPath);
        end;
        DocumentCount := StrToInt(Reply.Values['document_count']);
        for I := 0 to DocumentCount - 1 do begin
            InstalledPath := Reply.Values['document' + IntToStr(I)];
            if Project.DM_IndexOfSourceDocument(InstalledPath) < 0 then Project.DM_AddSourceDocument(InstalledPath);
        end;
    finally
        Reply.Free;
    end;
    try
        MyLibraryFormV31.Enabled := False;
        MyLibraryFormV31.ImportProgress.Position := 90;
        MyLibraryFormV31.StatusLabel.Caption := 'AD: compiling MyLibrary.IntLib and checking all default footprints (90%).';
        MyLibraryFormV31.Show;
        MyLibraryFormV31.Repaint;
        Project.DM_SetAsCurrentProject;
        if not Project.DM_Compile then begin ShowMessage('MyLibrary compilation failed. Review AD Messages.'); Exit; end;
        if not FileExists(LibraryPath) then begin ShowMessage('Library compilation failed. Review the AD Messages panel.'); Exit; end;
        Manager.InstallLibrary(LibraryPath);
        if Manager.GetComponentCount(LibraryPath) <> ExpectedCount then begin ShowMessage('MyLibrary compilation did not include all components. Review AD Messages.'); Exit; end;
        if Manager.ModelCount(SymbolName, LibraryPath, 'PCBLIB') <> 1 then begin ShowMessage('Compiled component does not have exactly one footprint.'); Exit; end;
        if Manager.ModelName(SymbolName, LibraryPath, 'PCBLIB', 0) <> FootprintName then begin ShowMessage('Compiled footprint name does not match the downloaded component.'); Exit; end;
        if not VerifyMasterModels(Manager, BridgeReplyPath) then begin ShowMessage('Master-library model validation failed.'); Exit; end;
        MyLibraryFormV31.ImportProgress.Position := 100;
        MyLibraryFormV31.StatusLabel.Caption := 'Complete: source libraries, compiled IntLib and default footprint checks passed (100%).';
        MyLibraryFormV31.Repaint;
        for I := Manager.InstalledLibraryCount - 1 downto 0 do begin
            InstalledPath := Manager.InstalledLibraryPath(I);
            if (UpperCase(ExtractFileName(InstalledPath)) = UpperCase(ExtractFileName(LibraryPath))) and (UpperCase(InstalledPath) <> UpperCase(LibraryPath)) and (Pos(UpperCase(BridgeCache + '\bound\'), UpperCase(InstalledPath)) = 1) then Manager.UninstallLibrary(InstalledPath);
        end;
        if PlaceNow then begin
            if OriginalProject <> Nil then OriginalProject.DM_SetAsCurrentProject;
            Client.ShowDocument(Client.OpenDocument('SCH', SheetPath));
            X := MilsToCoord(1000);
            Y := MilsToCoord(1000);
            if not Manager.PlaceLibraryComponent(SymbolName, LibraryPath, 'Orientation=0|Location.X=' + IntToStr(X) + '|Location.Y=' + IntToStr(Y)) then begin ShowMessage('Installed successfully. Place the component from the Components panel.'); Exit; end;
            SchServer.GetCurrentSchDocument.GraphicallyInvalidate;
        end else ShowMessage('MyLibrary updated: ' + SymbolName + #13 + 'Use Components > MyLibrary.IntLib to drag the component into your schematic.');
        Reply := TStringList.Create;
        try
            Reply.Add('compiled_library=' + LibraryPath);
            Reply.Add('symbol=' + SymbolName);
            Reply.Add('footprint=' + FootprintName);
            Reply.Add('native_compile_and_model_query=passed');
            if PlaceNow then Reply.Add('placement_api_returned_true=True') else Reply.Add('placement_api_returned_true=not_run');
            Reply.Add('visual_3d_alignment=not_verified');
            Reply.SaveToFile(ExtractFilePath(LibraryPath) + 'native-ad-result.ini');
        finally
            Reply.Free;
        end;
    finally
        MyLibraryFormV31.Hide;
        MyLibraryFormV31.Enabled := True;
        if OriginalProject <> Nil then OriginalProject.DM_SetAsCurrentProject;
    end;
end;

procedure ImportToMyLibrary;
begin
    ImportComponent(False);
end;


procedure RebuildMyLibrary;
var Reply, ResultFile : TStringList; Project : IProject; Manager : IIntegratedLibraryManager; LibraryPath, SourcePath, SymbolName : String; I, Count, Expected, RemoveCount : Integer;
begin
    Reply := TStringList.Create;
    try
        Reply.LoadFromFile(MyLibraryRoot + '\LCSC-import-pending.ini');
        Project := GetWorkspace.DM_OpenProject(Reply.Values['project'], True);
        if Project = Nil then begin ShowMessage('Cannot open MyLibrary.LibPkg.'); Exit; end;
        RemoveCount := StrToInt(Reply.Values['remove_document_count']);
        for I := 0 to RemoveCount - 1 do begin
            SourcePath := Reply.Values['remove_document' + IntToStr(I)];
            if Project.DM_IndexOfSourceDocument(SourcePath) >= 0 then Project.DM_RemoveSourceDocument(SourcePath);
        end;
        if not SaveNativeSource(Reply.Values['schlib'], 'SCHLIB', 'Advanced Schematic binary library') then begin ShowMessage('Native MyParts save failed.'); Exit; end;
        if not SaveNativeSource(Reply.Values['pcblib'], 'PCBLIB', 'PCB Library File') then begin ShowMessage('Native MyFootprints save failed.'); Exit; end;
        Count := StrToInt(Reply.Values['document_count']);
        for I := 0 to Count - 1 do begin
            SourcePath := Reply.Values['document' + IntToStr(I)];
            if Project.DM_IndexOfSourceDocument(SourcePath) < 0 then Project.DM_AddSourceDocument(SourcePath);
        end;
        LibraryPath := Reply.Values['intlib'];
        SymbolName := Reply.Values['symbol'];
        Expected := StrToInt(Reply.Values['expected_components']);
        Manager := IntegratedLibraryManager;
        Project.DM_SetAsCurrentProject;
        if not Project.DM_Compile then begin ShowMessage('MyLibrary compilation failed. Review AD Messages.'); Exit; end;
        Manager.InstallLibrary(LibraryPath);
        if Manager.GetComponentCount(LibraryPath) < Expected then begin ShowMessage('Compilation failed. Review AD Messages.'); Exit; end;
        if Manager.ModelCount(SymbolName, LibraryPath, 'PCBLIB') <> 1 then begin ShowMessage('The component footprint was not included.'); Exit; end;
        if not VerifyMasterModels(Manager, MyLibraryRoot + '\LCSC-import-pending.ini') then begin ShowMessage('Master-library model validation failed.'); Exit; end;
        ResultFile := TStringList.Create;
        try
            ResultFile.Add('compiled_library=' + LibraryPath);
            ResultFile.Add('symbol=' + SymbolName);
            ResultFile.Add('footprint=' + Reply.Values['footprint']);
            ResultFile.Add('native_compile_and_model_query=passed');
            ResultFile.Add('placement_api_returned_true=not_run');
            ResultFile.Add('visual_3d_alignment=not_verified');
            ResultFile.SaveToFile(ExtractFilePath(LibraryPath) + 'native-ad-result.ini');
        finally
            ResultFile.Free;
        end;
        ShowMessage('MyLibrary updated: ' + IntToStr(Manager.GetComponentCount(LibraryPath)) + ' components.');
    finally
        Reply.Free;
    end;
end;

End.
